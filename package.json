{
  "name": "modglow",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "A moderator only Devvit tool for publishing attributed community spotlight images from manually selected comments.",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "devvit playtest",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test src/**/*.test.ts",
    "lint": "eslint 'src/**/*.ts'",
    "check": "npm run typecheck && npm run test:unit && npm run lint && npm run build",
    "deploy": "npm run check && devvit upload",
    "launch": "npm run deploy && devvit publish",
    "login": "devvit login"
  },
  "dependencies": {
    "@devvit/reddit": "0.15.3",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hono/node-server": "^2.0.3",
    "@resvg/resvg-wasm": "2.6.2",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "@fontsource/noto-sans-malayalam": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  },
  "overrides": {
    "devvit": {
      "isomorphic-git": "1.38.6",
      "tmp": "0.2.7"
    },
    "eslint": {
      "minimatch": "11.0.8"
    },
    "typescript-eslint": {
      "minimatch": "11.0.8"
    }
  }
}
