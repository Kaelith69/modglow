{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modglow",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create ModGlow announcement",
        "description": "Write a Markdown announcement and publish it as a pinned ModGlow image comment. Moderator action only.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-announcement"
      }
    ]
  },
  "forms": {
    "createAnnouncement": "/internal/form/create-announcement-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "media": true,
    "redis": true
  },
  "marketingAssets": {
    "icon": "assets/modglow-icon.png"
  }
}
