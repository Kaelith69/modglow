{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modglow",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create ModGlow announcement",
        "description": "Write a Markdown announcement and publish it as a pinned ModGlow image comment. Moderator action only.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-announcement"
      },
      {
        "label": "Edit ModGlow announcement",
        "description": "Edit this app's verified announcement without publishing a duplicate.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/edit-announcement"
      },
      {
        "label": "Delete ModGlow announcement",
        "description": "Permanently delete this app's verified announcement.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/delete-announcement"
      }
    ]
  },
  "forms": {
    "createAnnouncement": "/internal/form/create-announcement-submit",
    "editAnnouncement": "/internal/form/edit-announcement-submit",
    "deleteAnnouncement": "/internal/form/delete-announcement-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "media": true,
    "redis": true
  },
  "marketingAssets": {
    "icon": "assets/modglow-icon.png"
  }
}
